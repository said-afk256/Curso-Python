#Importación de librerias
import os
import time
import msvcrt

#Programa para sacar porcentaje a un número rapidamente

#Verificación de que el input es un número
while True:
    try:
        numero=float(input("Ingresa el número al que vas a sacar porcentaje: "))
        porcentaje=float(input("Ingresa el porcentaje que quieras obtener del número: "))
        print("Números validos")
        break

    except ValueError:
        print("Lo ingresado no es valido, escribe números")
        time.sleep(1.5)#Segundos antes de ejecutar el código system
        os.system('cls' if os.name == 'nt' else "clear")#Limpia la terminal para que se vea mas limpia
print()

#Logica
valor_final=(numero*porcentaje)/100
print(f"El porcentaje {porcentaje}% del número {numero} es: {valor_final:g}")
#El ":g" hace que si el resultado númerico no tiene decimales pero es un float, se quite al final el decimal
#Por ejemplo: 50.0 pasa a 50, pero si es 50.5 se queda asi

#Apagado
print("\nLa pantalla se limpiará en 10 segundos o al presionar cualquier tecla...")


for i in range (10):
    time.sleep(1) #Espera de en 1 en 1 seg
    
    if msvcrt.kbhit():
        
        msvcrt.getch()
        break
    
os.system("cls" if os.name == "nt" else "clear")
print("Terminal limpia")
    