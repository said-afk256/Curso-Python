#Importación de librerias
import os
import time
import msvcrt

#Programa para calcular qué porcentaje representa una cantidad de un total

#Verificación de que el input es un número
while True:
    try:
        total = float(input("Ingresa el número TOTAL (el 100%): "))
        cantidad = float(input("Ingresa la CANTIDAD de la que quieres saber su porcentaje: "))
        
        # Validación extra: Evitar que el total sea cero para que el programa no "truene" matemáticamente
        if total == 0:
            print("El número total no puede ser 0 (no se puede dividir entre cero).")
            time.sleep(2)
            os.system('cls' if os.name == 'nt' else 'clear')
            continue # Reinicia el ciclo para volver a preguntar
            
        print("Números válidos")
        break

    except ValueError:
        print("Lo ingresado no es válido, escribe números")
        time.sleep(1.5) # Segundos antes de limpiar la terminal
        os.system('cls' if os.name == 'nt' else 'clear') # Limpia la terminal
print()

#Lógica para obtener el porcentaje
porcentaje_resultante = (cantidad / total) * 100

#Impresión del resultado
# El ":g" quita ceros decimales innecesarios tanto de las entradas como del resultado final
print(f"La cantidad {cantidad:g} representa el {porcentaje_resultante:g}% del total ({total:g}).")

#Apagado interactivo
print("\nLa pantalla se limpiará en 10 segundos o al presionar cualquier tecla...")

for i in range(15):
    time.sleep(1) # Espera de 1 en 1 segundo
    
    if msvcrt.kbhit():
        msvcrt.getch() # Atrapa la tecla presionada para limpiar el buffer
        break # Detiene la cuenta regresiva e interrumpe
    
os.system("cls" if os.name == "nt" else "clear")
print("Terminal limpia")
print()

